# These are executed by bash inside Linux containers, via a bind mount straight
# from the working tree. Checked out with CRLF on Windows they fail with
# "$'\r': command not found", and the stack comes up with no topics and no
# bucket. Pin them to LF regardless of platform or core.autocrlf.
*.sh text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Generated by protoc; never diffed by hand and never merged.
src/faas/v1/*_pb2.py linguist-generated=true
src/faas/v1/*_pb2.pyi linguist-generated=true

# Audio, if any ever gets committed deliberately.
*.flac binary
*.mp3 binary
*.wav binary
