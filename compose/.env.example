# Tunables for the local stack. Copy to .env and edit for a bigger or nastier
# run -- every value here also has a default in docker-compose.yml, so the stack
# comes up without this file at all.
#
# .env itself is gitignored, which is why this copy exists.

# Object store credentials. Local only -- MinIO, on a private compose network.
MINIO_USER=faas
MINIO_PASSWORD=faas-secret
FAAS_AUDIO_BUCKET=faas-audio

# Must match `results_topic_partitions` in the function declarations, which
# defaults to 200 in faas_sdk.config. Lower these *and* the declarations
# together, never one alone -- see the note in init/topics.sh.
RESULTS_PARTITIONS=200
INTERNAL_PARTITIONS=200
RAW_PARTITIONS=12

HYDRATOR_REPLICAS=2

# -- how hard to push ----------------------------------------------------

# Audio API fault injection. 0 is a clean run; 0.1 puts roughly a tenth of
# fetches through the retry ladder.
AUDIO_API_ERROR_RATE=0
AUDIO_API_LATENCY_MS=0

# slow_burner's cost per minute of audio, against its 15s timeout. At 20 the
# 5-minute file times out and the shorter files do not.
BURN_SECONDS_PER_MINUTE=20

# flaky_analyzer's failure buckets, by hash of call_id.
FLAKY_TRANSIENT_RATE=0.15
FLAKY_POISON_RATE=0.05

FAAS_LOG_LEVEL=INFO

# -- console powers ------------------------------------------------------
#
# The sandbox executes arbitrary Python behind an HTTP request; writes stop
# containers, replay records and commit to your checkout. The console has no
# authentication, so enable these only on a machine where you would hand a
# shell to anyone who can reach port 8000.
CONSOLE_SANDBOX=0
CONSOLE_ALLOW_WRITES=0
